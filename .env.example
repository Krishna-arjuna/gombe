# MongoDB Atlas or local MongoDB connection string
MONGODB_URI=mongodb+srv://<db_username>:<url_encoded_password>@<cluster-host>/<database>?retryWrites=true&w=majority
PORT=3000

# Admin access is disabled until all three values are set.
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-admin-password
# Generate a unique secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Generate a separate random secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CUSTOMER_SESSION_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters

# Optional. Online checkout stays disabled until valid Razorpay test/live keys are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Fees are whole INR amounts. Review these values and applicable local tax/shipping rules before launch.
SHIPPING_FEE_INR=0
GIFT_WRAP_FEE_INR=0
